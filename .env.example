# Copy this to .env and fill in what you have. .env is gitignored and is never
# printed by `ic check` — only whether a value is present.
#
# Everything runs without any of these. Slack and Gmail rehearse: they compose
# the real message, write it to out/, and report `rehearsed` rather than
# pretending to send. The ntfy alert is delivered for real regardless.

# ── Slack ────────────────────────────────────────────────────────────
# api.slack.com/apps → Create New App → From scratch
# OAuth & Permissions → Bot Token Scopes: channels:manage, chat:write,
#                                         channels:read
# Install to Workspace → copy the Bot User OAuth Token
SLACK_BOT_TOKEN=

# ── Gmail ────────────────────────────────────────────────────────────
# Needs 2-Step Verification on, then myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=

# ── Responder alert (optional) ───────────────────────────────────────
# Left blank, a stable topic is generated on first run and remembered in
# .cache/ntfy-topic. Set it explicitly to subscribe from a phone beforehand.
# NOTE: ntfy topics are public — anyone who knows the name can read them.
ARGUS_NTFY_TOPIC=

# ── Summary prose (optional) ─────────────────────────────────────────
# With a key, a model writes the two-sentence summary and its output is checked
# against the evidence — anything it introduces is rejected. Without one, a
# deterministic template is used. Claude is preferred where both are set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: pin a model instead of discovering one. e.g. models/gemini-2.5-flash
GEMINI_MODEL=
